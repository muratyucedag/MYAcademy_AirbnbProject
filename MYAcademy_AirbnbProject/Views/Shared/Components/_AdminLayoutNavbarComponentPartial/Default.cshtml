<header class="topbar">
    <div class="tb-left">
        <button type="button" class="icon-btn" id="sbToggle" aria-label="Menüyü daralt" aria-controls="sidebar" aria-expanded="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3.5" y="4.5" width="17" height="15" rx="2" /><path d="M9.5 4.5v15" /></svg>
        </button>
        <!-- Razor: ViewData["Breadcrumb"] ile doldurulabilir -->
        <nav class="breadcrumb" aria-label="Sayfa konumu">
            <ol>
                <li><span>Yönetim Paneli</span></li>
                <li><span aria-current="page">Rezervasyon Listesi</span></li>
            </ol>
        </nav>
    </div>
    <div class="tb-right">
        <label class="tb-search">
            <span class="sr-only">Rezervasyonlarda ara</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" /></svg>
            <input type="search" class="input" id="topSearch" placeholder="Hızlı ara…" autocomplete="off">
            <kbd>/</kbd>
        </label>
        <button type="button" class="icon-btn" id="notifBtn" aria-label="Bildirimler (5 bekleyen rezervasyon)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9.5a6 6 0 1112 0c0 4.5 1.8 6 1.8 6H4.2S6 14 6 9.5zM10 19a2.2 2.2 0 004 0" /></svg>
            <span class="dot" id="notifDot">5</span>
        </button>
        <span class="tb-sep" aria-hidden="true"></span>
        <button type="button" class="tb-user" data-soon aria-label="Hesap: Selin Kaya">
            <span class="avatar" aria-hidden="true">SK</span>
            <span class="tb-user-text"><b>Selin Kaya</b><small>Sistem Yöneticisi</small></span>
        </button>
    </div>
</header>