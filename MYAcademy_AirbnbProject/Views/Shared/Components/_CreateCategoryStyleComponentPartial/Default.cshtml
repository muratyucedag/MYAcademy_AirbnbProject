<style>
    /* =====================================================================
               [CSS] CreateCategory — sadece bu sayfaya ait stiller
               (Genel .card, .btn, .input, .page-head vb. layout CSS'inden gelir)
               ===================================================================== */
    .cc-grid {
        display: grid;
        grid-template-columns: minmax(0,1fr) 340px;
        gap: 24px;
        align-items: start
    }

    .cc-section {
        padding: 20px 22px;
        border-bottom: 1px solid var(--line)
    }

        .cc-section:last-of-type {
            border-bottom: 0
        }

    .cc-section-head {
        margin-bottom: 14px
    }

        .cc-section-head h2 {
            font-size: 16px;
            font-weight: 700
        }

        .cc-section-head p {
            font-size: 13.5px;
            color: var(--muted);
            margin-top: 2px
        }

    .cc-field {
        display: flex;
        flex-direction: column;
        gap: 6px
    }

        .cc-field + .cc-field {
            margin-top: 16px
        }

        .cc-field label, .cc-label {
            font-size: 13.5px;
            font-weight: 600
        }

            .cc-field label .req {
                color: var(--danger);
                margin-left: 2px
            }

        .cc-field .input {
            width: 100%
        }

        .cc-field textarea {
            width: 100%;
            min-height: 110px;
            resize: vertical;
            border: 1px solid var(--line);
            border-radius: var(--radius-s);
            padding: 10px 12px;
            font-size: 14px;
            line-height: 1.5;
            background: #fff;
            transition: border-color .15s,box-shadow .15s
        }

            .cc-field textarea:focus {
                outline: none;
                border-color: #B8C0CA;
                box-shadow: 0 0 0 3px rgba(198,138,45,.14)
            }

    .cc-hint-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 12.5px;
        color: var(--muted)
    }

    .cc-counter.is-near {
        color: var(--warning-tx);
        font-weight: 600
    }

    /* Doğrulama (ASP.NET Core sınıfları) */
    .field-validation-error {
        font-size: 12.5px;
        color: var(--danger-tx);
        font-weight: 500
    }

    .input-validation-error, textarea.input-validation-error {
        border-color: var(--danger) !important
    }

    .validation-summary-errors {
        margin: 0 0 20px;
        padding: 12px 14px;
        border-radius: var(--radius-s);
        background: var(--danger-bg);
        color: #7F2A27;
        font-size: 14px
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px
        }

    .validation-summary-valid {
        display: none
    }

    /* İkon seçici */
    .cc-icons {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(92px,1fr));
        gap: 10px;
        border: 0;
        margin: 0;
        padding: 0
    }

    .cc-icon {
        position: relative
    }

        .cc-icon input {
            position: absolute;
            opacity: 0;
            width: 1px;
            height: 1px
        }

        .cc-icon label {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            height: 88px;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            background: #fff;
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
            color: #4B5563;
            transition: border-color .15s,background .15s,color .15s,box-shadow .15s
        }

            .cc-icon label svg {
                width: 26px;
                height: 26px
            }

            .cc-icon label:hover {
                border-color: #C9CED6;
                background: #FAFBFC;
                color: var(--text)
            }

        .cc-icon input:checked + label {
            border-color: var(--accent);
            background: var(--accent-soft);
            color: var(--accent-dark);
            font-weight: 600;
            box-shadow: 0 0 0 1px var(--accent) inset
        }

        .cc-icon input:focus-visible + label {
            outline: 2px solid var(--accent);
            outline-offset: 2px
        }

    /* Aktif/pasif anahtarı */
    .cc-switch {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        cursor: pointer
    }

        .cc-switch b {
            display: block;
            font-size: 14.5px;
            font-weight: 600
        }

        .cc-switch small {
            display: block;
            font-size: 13px;
            color: var(--muted);
            margin-top: 2px
        }

    .cc-toggle {
        position: relative;
        flex: none;
        width: 46px;
        height: 26px
    }

        .cc-toggle input {
            position: absolute;
            inset: 0;
            opacity: 0;
            margin: 0;
            cursor: pointer;
            z-index: 1
        }

        .cc-toggle span {
            position: absolute;
            inset: 0;
            border-radius: 999px;
            background: #D1D5DB;
            transition: background .15s
        }

            .cc-toggle span::after {
                content: "";
                position: absolute;
                top: 3px;
                left: 3px;
                width: 20px;
                height: 20px;
                border-radius: 50%;
                background: #fff;
                box-shadow: 0 1px 3px rgba(17,24,39,.25);
                transition: transform .15s
            }

        .cc-toggle input:checked + span {
            background: var(--success)
        }

            .cc-toggle input:checked + span::after {
                transform: translateX(20px)
            }

        .cc-toggle input:focus-visible + span {
            outline: 2px solid var(--accent);
            outline-offset: 2px
        }

    .cc-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 14px 22px;
        border-top: 1px solid var(--line);
        background: #FAFBFC;
        border-radius: 0 0 var(--radius) var(--radius)
    }

    /* Önizleme */
    .cc-side {
        position: sticky;
        top: calc(var(--top-h) + 24px);
        display: grid;
        gap: 16px
    }

        .cc-side .card-head {
            padding: 16px 18px 0
        }

            .cc-side .card-head h2 {
                font-size: 15px
            }

    .cc-preview {
        padding: 16px 18px 18px
    }

    .cc-chips {
        display: flex;
        gap: 22px;
        padding: 4px 2px 0;
        border-bottom: 1px solid var(--line);
        overflow: hidden
    }

    .cc-chip {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding-bottom: 10px;
        font-size: 12.5px;
        font-weight: 500;
        color: #9CA3AF;
        white-space: nowrap;
        flex: none
    }

        .cc-chip svg {
            width: 22px;
            height: 22px
        }

        .cc-chip.is-active {
            color: var(--text);
            font-weight: 600;
            box-shadow: 0 -2px 0 var(--text) inset
        }

            .cc-chip.is-active b {
                max-width: 110px;
                overflow: hidden;
                text-overflow: ellipsis;
                font-weight: 600
            }

    .cc-pv-card {
        margin-top: 16px;
        display: flex;
        gap: 14px;
        align-items: flex-start
    }

    .cc-pv-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: var(--accent-soft);
        color: var(--accent-dark);
        flex: none
    }

        .cc-pv-icon svg {
            width: 24px;
            height: 24px
        }

    .cc-pv-body {
        min-width: 0;
        flex: 1
    }

        .cc-pv-body h3 {
            font-size: 16px;
            font-weight: 700;
            word-break: break-word
        }

        .cc-pv-body p {
            font-size: 13.5px;
            color: var(--muted);
            margin-top: 4px;
            word-break: break-word
        }

        .cc-pv-body .badge {
            margin-top: 10px
        }

    .cc-placeholder {
        color: #9CA3AF !important;
        font-style: italic;
        font-weight: 500 !important
    }

    .cc-tips {
        padding: 16px 18px;
        font-size: 13.5px;
        color: #4B5563
    }

        .cc-tips h2 {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text)
        }

        .cc-tips ul {
            margin: 0;
            padding-left: 18px;
            display: grid;
            gap: 6px
        }

    @@media (max-width:1100px) {
        .cc-grid {
            grid-template-columns: 1fr
        }

        .cc-side {
            position: static
        }
    }

    @@media (max-width:760px) {
        .cc-section {
            padding: 16px 14px
        }

        .cc-actions {
            padding: 12px 14px
        }

            .cc-actions .btn {
                flex: 1
            }

        .cc-icons {
            grid-template-columns: repeat(3,minmax(0,1fr))
        }
    }
</style>