@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Kategori Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    // İkon anahtarı → SVG (CreateCategory sayfasındaki liste ile aynı anahtarlar)
    var iconSvgs = new Dictionary<string, string>
    {
        ["home"] = "<path d='M3.5 11L12 4l8.5 7M5.5 9.5V20h13V9.5M10 20v-5h4v5'/>",
        ["beach"] = "<path d='M4 11a8 8 0 0116 0H4z'/><path d='M12 11v8.5M3 20.5c2-1.2 4-1.2 6 0s4 1.2 6 0 4-1.2 6 0'/>",
        ["mountain"] = "<path d='M2.5 19.5L9 8l4 7 2.5-4 6 8.5z'/><path d='M7.2 11.2L9 12.5l1.6-1.3'/>",
        ["city"] = "<path d='M4 20.5V8h6v12.5M10 20.5V4h7v16.5M17 20.5V11h3.5v9.5M2.5 20.5h19M6.5 11h1M6.5 14h1M6.5 17h1M12.5 7h2M12.5 10h2M12.5 13h2M12.5 16h2'/>",
        ["pool"] = "<path d='M8 15V5.5a2 2 0 014 0M16 15V5.5a2 2 0 00-4 0M8 9h8M8 12.5h8M3 18c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0'/>",
        ["lake"] = "<path d='M3 9c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0M3 13.5c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0M3 18c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0'/>",
        ["forest"] = "<path d='M12 3l5 7h-3l4 6H6l4-6H7l5-7zM12 16v5'/>",
        ["historic"] = "<path d='M3 9.5L12 4l9 5.5M4.5 9.5h15M6 9.5v8M10 9.5v8M14 9.5v8M18 9.5v8M4.5 17.5h15M3.5 20.5h17'/>",
        ["luxury"] = "<path d='M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L12 3.5z'/>",
        ["family"] = "<circle cx='9' cy='8' r='3.3'/><path d='M3 19.5c.9-3.1 3.2-4.8 6-4.8s5.1 1.7 6 4.8M16 4.9a3.2 3.2 0 010 6.2M18.3 14.8c1.5.7 2.4 2.2 2.8 4.7'/>",
        ["ski"] = "<path d='M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9M9.5 4.5L12 6.5l2.5-2M9.5 19.5L12 17.5l2.5 2'/>",
        ["cabin"] = "<path d='M3 20.5L12 4l9 16.5zM9 20.5l3-5.5 3 5.5'/>"
    };
    // Kullanım: @Icon("beach") — bilinmeyen anahtar gelirse boş daire gösterilir
    Func<string, IHtmlContent> Icon = key => Html.Raw(
        "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>"
        + (key != null && iconSvgs.ContainsKey(key) ? iconSvgs[key] : "<circle cx='12' cy='12' r='8' stroke-dasharray='2 3'/>")
        + "</svg>");
}

<style>
    /* =====================================================================
           [CSS] CategoryList — sadece bu sayfaya ait stiller
           (Genel .card, .btn, .table, .badge vb. layout CSS'inden gelir)
           ===================================================================== */
    .cl-table {
        min-width: 760px
    }

        .cl-table .c-no {
            width: 64px;
            color: var(--muted);
            font-variant-numeric: tabular-nums
        }

        .cl-table .c-act {
            width: 1%;
            white-space: nowrap
        }

    .cl-cat {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0
    }

    .cl-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--accent-soft);
        color: var(--accent-dark);
        flex: none
    }

        .cl-icon svg {
            width: 20px;
            height: 20px
        }

    .cl-cat b {
        display: block;
        font-weight: 600
    }

    .cl-cat small {
        display: block;
        font-size: 12.5px;
        color: var(--muted);
        font-family: ui-monospace,SFMono-Regular,Menlo,Consolas,monospace
    }

    .cl-desc {
        color: #4B5563;
        max-width: 420px
    }

    .cl-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px
    }

    .cl-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 34px;
        padding: 0 12px;
        border-radius: var(--radius-s);
        border: 1px solid var(--line);
        background: #fff;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--text);
        white-space: nowrap;
        transition: background .15s,border-color .15s,color .15s
    }

        .cl-btn svg {
            width: 16px;
            height: 16px
        }

        .cl-btn:hover {
            border-color: #C9CED6;
            background: #FAFBFC
        }

        .cl-btn.is-danger {
            color: var(--danger-tx);
            border-color: #F2C4C2
        }

            .cl-btn.is-danger:hover {
                background: var(--danger-bg);
                border-color: var(--danger)
            }

    .cl-foot {
        padding: 14px 20px;
        border-top: 1px solid var(--line);
        font-size: 13.5px;
        color: var(--muted)
    }

        .cl-foot b {
            color: var(--text);
            font-weight: 600
        }

    @@media (max-width:760px) {
        .cl-table {
            min-width: 0
        }

            .cl-table tbody tr {
                grid-template-columns: 1fr auto
            }

            .cl-table td.c-no {
                display: none
            }

            .cl-table td.c-cat {
                grid-column: 1
            }

            .cl-table td.c-status {
                grid-column: 2;
                grid-row: 1;
                align-self: center
            }

            .cl-table td.c-desc, .cl-table td.c-act {
                grid-column: 1/-1;
                grid-row: auto
            }

        .cl-actions {
            justify-content: stretch
        }

        .cl-btn {
            flex: 1;
            justify-content: center
        }

        .cl-foot {
            padding: 12px 14px
        }
    }
</style>

<!-- ▼▼▼ Sayfa başlığı ▼▼▼ -->
<section class="page-head">
    <div>
        <h1>Kategoriler</h1>
        <p>Konaklamaların gruplandığı kategorileri görüntüleyin ve yönetin.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-accent" asp-action="CreateCategory">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            Yeni Kategori
        </a>
    </div>
</section>

<!-- ▼▼▼ Kategori tablosu ▼▼▼ -->
<section class="card" aria-labelledby="categoryTableTitle">
    <div class="card-head" style="padding-bottom:16px;border-bottom:1px solid var(--line)">
        <h2 id="categoryTableTitle">Tüm Kategoriler <span class="count-chip">3</span></h2>
        <span class="meta">Kayıt sırasına göre</span>
    </div>

    <div class="table-wrap">
        <table class="table cl-table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Kategori</th>
                    <th scope="col">Açıklama</th>
                    <th scope="col">Durum</th>
                    <th scope="col" class="t-right">İşlemler</th>
                </tr>
            </thead>
            <!--
              VERİ: Satırlar doğrudan aşağıdaki <tr> bloklarındadır.
              Yeni satır için bir <tr> bloğunu kopyalayıp değerleri değiştirin.
              İkon: @@Icon("anahtar") → home, beach, mountain, city, pool, lake,
                    forest, historic, luxury, family, ski, cabin
              Durum: Aktif → <span class="badge b-ok">Aktif</span>
                     Pasif → <span class="badge b-done">Pasif</span>
              Düzenle/Sil bağlantılarındaki asp-route-id değeri satırın Id'sidir.

              Veritabanına bağlarken tbody içini şu döngüyle değiştirebilirsiniz:
              @@foreach (var item in Model)
              {
                  <tr>
                      <td class="c-no">@@item.CategoryId</td>
                      <td class="c-cat">… @@Icon(item.Icon) … @@item.CategoryName … @@item.Icon …</td>
                      <td class="c-desc">@@item.Description</td>
                      <td class="c-status">@@(item.IsActive ? "Aktif" : "Pasif")</td>
                      <td class="c-act">… asp-route-id="@@item.CategoryId" …</td>
                  </tr>
              }
            -->
            <tbody>
                <tr>
                    <td class="c-no">1</td>
                    <td class="c-cat" data-label="Kategori">
                        <div class="cl-cat">
                            <span class="cl-icon">@Icon("beach")</span>
                            <div><b>Sahil Kenarı</b><small>beach</small></div>
                        </div>
                    </td>
                    <td class="c-desc" data-label="Açıklama"><div class="cl-desc">Denize yürüme mesafesinde, manzaralı konaklamalar.</div></td>
                    <td class="c-status" data-label="Durum"><span class="badge b-ok">Aktif</span></td>
                    <td class="c-act">
                        <div class="cl-actions">
                            <a class="cl-btn" asp-action="UpdateCategory" asp-route-id="1">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4l10.5-10.5a2.8 2.8 0 00-4-4L4 16v4zM13.5 6.5l4 4" /></svg>
                                Düzenle
                            </a>
                            <a class="cl-btn is-danger" asp-action="DeleteCategory" asp-route-id="1" data-confirm="Sahil Kenarı">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 7h15M9.5 7V4.5h5V7M6.5 7l1 13h9l1-13M10 11v5.5M14 11v5.5" /></svg>
                                Sil
                            </a>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="c-no">2</td>
                    <td class="c-cat" data-label="Kategori">
                        <div class="cl-cat">
                            <span class="cl-icon">@Icon("mountain")</span>
                            <div><b>Dağ Evleri</b><small>mountain</small></div>
                        </div>
                    </td>
                    <td class="c-desc" data-label="Açıklama"><div class="cl-desc">Doğayla iç içe, şehirden uzak ve sakin dağ evleri.</div></td>
                    <td class="c-status" data-label="Durum"><span class="badge b-ok">Aktif</span></td>
                    <td class="c-act">
                        <div class="cl-actions">
                            <a class="cl-btn" asp-action="UpdateCategory" asp-route-id="2">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4l10.5-10.5a2.8 2.8 0 00-4-4L4 16v4zM13.5 6.5l4 4" /></svg>
                                Düzenle
                            </a>
                            <a class="cl-btn is-danger" asp-action="DeleteCategory" asp-route-id="2" data-confirm="Dağ Evleri">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 7h15M9.5 7V4.5h5V7M6.5 7l1 13h9l1-13M10 11v5.5M14 11v5.5" /></svg>
                                Sil
                            </a>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="c-no">3</td>
                    <td class="c-cat" data-label="Kategori">
                        <div class="cl-cat">
                            <span class="cl-icon">@Icon("historic")</span>
                            <div><b>Tarihi Konaklar</b><small>historic</small></div>
                        </div>
                    </td>
                    <td class="c-desc" data-label="Açıklama"><div class="cl-desc">Tarihi dokuyu koruyan, restore edilmiş eski yapılar.</div></td>
                    <td class="c-status" data-label="Durum"><span class="badge b-done">Pasif</span></td>
                    <td class="c-act">
                        <div class="cl-actions">
                            <a class="cl-btn" asp-action="UpdateCategory" asp-route-id="3">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4l10.5-10.5a2.8 2.8 0 00-4-4L4 16v4zM13.5 6.5l4 4" /></svg>
                                Düzenle
                            </a>
                            <a class="cl-btn is-danger" asp-action="DeleteCategory" asp-route-id="3" data-confirm="Tarihi Konaklar">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 7h15M9.5 7V4.5h5V7M6.5 7l1 13h9l1-13M10 11v5.5M14 11v5.5" /></svg>
                                Sil
                            </a>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="cl-foot">Toplam <b>3</b> kategori</div>
</section>

<script>
    // Sil butonları: silmeden önce onay iste
    document.querySelectorAll("[data-confirm]").forEach(function (a) {
        a.addEventListener("click", function (e) {
            var name = a.getAttribute("data-confirm");
            if (!confirm('"' + name + '" kategorisi silinecek. Bu işlem geri alınamaz. Devam edilsin mi?')) e.preventDefault();
        });
    });
</script>
